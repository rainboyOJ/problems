extends layout.pug

block title
  | 比赛 - ROJ

block content
  .shell
    section.page-heading
      .page-heading-copy
        p.eyebrow ROJ / CONTESTS
        h1 比赛
        p.page-lead 浏览比赛安排、题目清单与相关说明。
      .heading-count
        strong #{contests.length}
        span 场比赛

    if contests.length
      .table-wrap
        table.problem-table.contest-table
          caption.visually-hidden 比赛列表
          thead
            tr
              th(scope="col") 比赛
              th(scope="col") 日期
              th(scope="col") 状态
              th(scope="col") 组织者
              th(scope="col") 标签
          tbody
            each contest in contests
              tr
                td.contest-title-cell
                  p.contest-slug #{contest.slug}
                  a.problem-title-link(href=`/contest/${contest.slug}`) #{contest.title}
                  if contest.description
                    p.contest-table-description #{contest.description}
                td.contest-date-cell
                  if contest.date
                    time(datetime=contest.date) #{contest.date}
                    if contest.endDate
                      span.contest-date-separator 至
                      time(datetime=contest.endDate) #{contest.endDate}
                  else
                    span.muted 未提供
                td
                  if contest.statusLabel
                    span(class=`contest-status contest-status-${contest.status}`) #{contest.statusLabel}
                  else
                    span.muted 未标注
                td.contest-organizer-cell
                  if contest.organizer
                    | #{contest.organizer}
                  else
                    span.muted 未提供
                td.contest-tags-cell
                  if contest.tags.length
                    .tag-list
                      each tag in contest.tags
                        span.tag #{tag}
                  else
                    span.muted 未标注
    else
      .empty-state
        span.empty-state-mark(aria-hidden="true") /
        h2 暂无比赛
        p 比赛资料添加到 contests 目录后会显示在这里。
